# Configuración del Bot
BOT_TOKEN=your_bot_token_here
SUPER_ADMIN_CHAT_ID=your_chat_id_here
# Opcional: chat/grupo al que se notificará cada arranque del bot.
# Si se omite, usa SUPER_ADMIN_CHAT_ID.
STARTUP_NOTIFY_CHAT_ID=

# No es necesario modificar estas rutas para Docker
DOWNLOAD_DIR=/data/downloads
SAVED_VIDEOS_DIR=/data/saved_videos
# Enviar mensaje de arranque con IPs (0 recomendado)
SEND_STARTUP_NOTIFICATION=0

# PostgreSQL para persistencia de usuarios
POSTGRES_DB=mediabot
POSTGRES_USER=mediabot
POSTGRES_PASSWORD=change-me-long-random-password
# Opcional: DATABASE_URL directo si no usas el Postgres del compose
# DATABASE_URL=postgresql://mediabot:change-me@mediabot-db:5432/mediabot

# Base de datos SQLite fallback si DATABASE_URL no está definido
DB_PATH=/data/db/users.db

# Opcional: cookies para sitios que exigen sesión (ej. algunos reels/posts de Instagram)
# Monta el archivo dentro del contenedor y apunta esta ruta al cookies.txt en formato Netscape.
# Ejemplo: YTDLP_COOKIES_FILE=/run/secrets/yt-dlp/instagram.cookies.txt
YTDLP_COOKIES_FILE=

# Alternativa avanzada: pasar un perfil de navegador accesible desde el contenedor.
# Ejemplos válidos de yt-dlp: firefox / firefox:/ruta/al/perfil
YTDLP_COOKIES_FROM_BROWSER=

# --- NFS (Opción A: Docker monta NFS directo con driver local) ---
# Usado por: docker-compose.nfs.yml
NFS_SERVER=192.168.X.Y
NFS_EXPORT_DOWNLOADS=/ruta/exportada/mediabot/downloads
NFS_EXPORT_SAVED_VIDEOS=/ruta/exportada/mediabot/saved_videos
# NFS_VERS=4

# --- NFS (Opción B: NFS ya montado en el host; usar bind-mount) ---
# Usado por: docker-compose.nfs.bind.yml
# Ejemplo: NFS_MOUNT_BASE=/mnt/raspi_videos
NFS_MOUNT_BASE=/ruta/del/mount/nfs